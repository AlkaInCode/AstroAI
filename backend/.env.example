# Database
DATABASE_URL=postgresql+psycopg://astroai:astroai@localhost:5432/astroai

# Auth
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Encrypts user-supplied LLM API keys at rest -- change and keep stable in production
ENCRYPTION_KEY=change-me-to-a-long-random-string

# Astrology calculation provider: mock, astroengine, or prokerala
ASTROLOGY_PROVIDER=mock
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=
# Self-hosted AstroEngine instance (no API key needed) -- see backend/README.md
ASTROENGINE_BASE_URL=http://192.168.68.114:8000

# Geocoding provider
GEOCODING_PROVIDER=mock
GEOCODING_API_KEY=

# LLM -- server-wide fallback used only for users who haven't set their own
# key in Settings. Supported providers: anthropic, openai, google, deepseek.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
